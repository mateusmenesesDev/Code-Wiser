model Project {
  id                      String                 @id @default(cuid())
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  title                   String
  description             String
  methodology             ProjectMethodologyEnum @default(SCRUM)
  minParticipants         Int
  maxParticipants         Int
  accessType              ProjectAccessTypeEnum
  difficulty              ProjectDifficultyEnum
  creditCost              Int?
  figmaProjectUrl         String?
  sourceProjectTemplateId String?
  sourceProjectTemplate   ProjectTemplate?       @relation("ProjectSourceTemplate", fields: [sourceProjectTemplateId], references: [id], onDelete: SetNull)
  githubRepositoryId      String?                @unique
  githubRepository        GitHubRepository?      @relation("ProjectGitHubRepository", fields: [githubRepositoryId], references: [id], onDelete: SetNull)
  publicCode              String?                @unique
  creationIdempotencyKey  String?                @unique
  nextTaskNumber          Int                    @default(1)

  portfolioSummary        String?
  portfolioDemoUrl        String?
  portfolioPublishedAt    DateTime?
  portfolioShowDemo       Boolean   @default(false)
  portfolioShowRepository Boolean   @default(false)
  portfolioFeedback       String?
  portfolioEvaluatedAt    DateTime?
  portfolioEvaluatedById  String?
  portfolioEvaluatedBy    User?     @relation("ProjectPortfolioEvaluator", fields: [portfolioEvaluatedById], references: [id], onDelete: SetNull)

  canceledAt                    DateTime?
  canceledById                  String?
  cancellationReason            String?
  refundCreditsOnCancellation   Boolean   @default(false)
  refundedCreditsOnCancellation Int       @default(0)

  tasks      Task[]
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  epics                 Epic[]
  sprints               Sprint[]
  milestones            Milestone[]
  learningOutcomes      LearningOutcome[]
  technologies          Technology[]
  memberships           ProjectMembership[]
  planningPokerSessions PlanningPokerSession[]
  invitations           ProjectInvitation[]

  @@index([canceledAt])
  @@index([sourceProjectTemplateId])
  @@index([portfolioPublishedAt])
  @@index([portfolioEvaluatedById])
  @@schema("public")
}
