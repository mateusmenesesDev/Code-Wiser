model ProjectImage {
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  id                String           @id @default(cuid())
  url               String
  alt               String?
  order             Int              @default(0)
  uploadId          String?          @unique
  ProjectTemplate   ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])
  projectTemplateId String?

  @@schema("public")
}

model LearningOutcome {
  id                String           @id @default(cuid())
  value             String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ProjectTemplate   ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])
  projectTemplateId String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String?

  @@index([projectId])
  @@schema("public")
}

model Category {
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  id              String            @id @default(cuid())
  name            String            @unique
  approved        Boolean           @default(false)
  projects        Project[]
  ProjectTemplate ProjectTemplate[]

  @@schema("public")
}

model Technology {
  id              String            @id @default(cuid())
  name            String            @unique
  approved        Boolean           @default(false)
  ProjectTemplate ProjectTemplate[]
  projects        Project[]

  @@schema("public")
}

model Milestone {
  id                String           @id @default(cuid())
  title             String
  description       String?
  order             Int              @default(0)
  status            String?          @default("PENDING")
  completed         Boolean          @default(false)
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ProjectTemplate   ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])
  projectTemplateId String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String?
  reviewedBy        User?            @relation("MilestoneReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  tasks             Task[]
  epics             Epic[]
  sprints           Sprint[]

  @@index([projectId, order])
  @@index([reviewedById])
  @@schema("public")
}
