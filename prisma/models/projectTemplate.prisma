model ProjectTemplate {
  id               String                 @id @default(cuid())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  title            String                 @unique
  description      String
  methodology      ProjectMethodologyEnum @default(SCRUM)
  minParticipants  Int
  maxParticipants  Int
  credits          Int?
  accessType       ProjectAccessTypeEnum
  status           ProjectStatusEnum      @default(PENDING)
  difficulty       ProjectDifficultyEnum
  figmaProjectUrl  String?
  publicCode       String?
  nextTaskNumber   Int                    @default(1)
  sortOrder        Int                    @default(0)
  tasks            Task[]
  technologies     Technology[]
  learningOutcomes LearningOutcome[]
  milestones       Milestone[]
  images           ProjectImage[]
  preRequisites    String[]
  expectedDuration String?
  categoryId       String
  category         Category               @relation(fields: [categoryId], references: [id])

  epics           Epic[]
  sprints         Sprint[]
  startedProjects Project[] @relation("ProjectSourceTemplate")

  @@index([status, sortOrder, createdAt])
  @@index([status, createdAt])
  @@index([status, categoryId, sortOrder])
  @@schema("public")
}
