enum MentorAttentionSourceType {
  PR_REVIEW
  EXERCISE_REVIEW
  BLOCKED_TASK
  INACTIVE_STUDENT
  MENTORSHIP_SESSION

  @@schema("public")
}

model MentorAttentionAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceType      MentorAttentionSourceType
  sourceId        String
  sourceCreatedAt DateTime

  assignedMentorId     String?
  assignedMentor       User?     @relation("MentorAttentionAssignments", fields: [assignedMentorId], references: [id], onDelete: SetNull)
  claimedAt            DateTime?
  firstResponseAt      DateTime?
  firstResponseMinutes Int?

  dueAt             DateTime
  escalatedAt       DateTime?
  completedAt       DateTime?
  completionMinutes Int?
  completedById     String?
  completedBy       User?     @relation("MentorAttentionCompletions", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([assignedMentorId, completedAt])
  @@index([sourceType, sourceCreatedAt])
  @@index([dueAt, escalatedAt])
  @@schema("public")
}
