enum MentorshipBookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MENTOR_CANCELLED

  @@schema("public")
}

enum MentorshipActionStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED

  @@schema("public")
}

model MentorshipBooking {
  id                String                  @id @default(uuid())
  userId            String
  calEventId        String
  calBookingId      String                  @unique
  scheduledAt       DateTime
  status            MentorshipBookingStatus @default(SCHEDULED)
  bookingUrl        String? // Cal.com booking management URL
  meetingUrl        String?
  objective         String?
  followUp          String?
  sessionNotes      String?
  mentorPrivateNote String?
  actionDueAt       DateTime?
  actionStatus      MentorshipActionStatus?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  competencyAssessments CompetencyMentorAssessment[]
  remediationActions    RemediationAction[]

  @@index([userId])
  @@index([userId, scheduledAt])
  @@index([scheduledAt])
  @@schema("public")
}
