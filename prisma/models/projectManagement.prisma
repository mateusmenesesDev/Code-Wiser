model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?

  type     TaskTypeEnum?     @default(USER_STORY)
  tags     String[]
  priority TaskPriorityEnum?
  status   TaskStatusEnum?   @default(BACKLOG)
  order    Int?              @default(0)

  dueDate      DateTime?
  publicNumber Int?

  blocked           Boolean? @default(false)
  blockedReason     String?
  portfolioRelevant Boolean  @default(false)

  storyPoints Int?
  assignees   User[]

  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id])
  projectTemplateId String?
  projectTemplate   ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])

  epicId      String?
  epic        Epic?      @relation(fields: [epicId], references: [id])
  sprintId    String?
  sprint      Sprint?    @relation(fields: [sprintId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  reviews PullRequestReview[]

  comments           Comment[]
  attachments        TaskAttachment[]
  planningPokerVotes PlanningPokerVote[]

  @@unique([projectTemplateId, title])
  @@unique([projectId, title])
  @@unique([projectTemplateId, publicNumber])
  @@unique([projectId, publicNumber])
  @@index([blocked, updatedAt])
  @@schema("public")
}

model TaskAttachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  url              String
  key              String
  originalFileName String
  displayName      String
  contentType      String
  sizeBytes        Int

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@schema("public")
}

model Epic {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?

  status    EpicStatusEnum?
  progress  Int?
  startDate DateTime?
  endDate   DateTime?

  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id])
  projectTemplateId String?
  projectTemplate   ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])

  tasks       Task[]
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@unique([projectTemplateId, title])
  @@unique([projectId, title])
  @@schema("public")
}

model Sprint {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  order       Int     @default(0)

  status SprintStatusEnum @default(PLANNING)

  projectTemplateId String?
  projectTemplate   ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  startDate DateTime?
  endDate   DateTime?

  tasks       Task[]
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@unique([projectTemplateId, title])
  @@unique([projectId, title])
  @@schema("public")
}

model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content String

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@schema("public")
}

model PullRequestReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prUrl                   String
  requestIdempotencyKey   String?           @unique
  githubPullRequestNumber Int?
  githubTitle             String?
  githubState             String?
  githubAuthorLogin       String?
  githubCommitCount       Int?
  githubHeadSha           String?
  githubChecksStatus      String?
  githubLastSyncedAt      DateTime?
  githubRepositoryId      String?
  githubRepository        GitHubRepository? @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)

  status     PullRequestReviewStatusEnum @default(PENDING)
  comment    String?
  reviewedAt DateTime?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("PullRequestReviewRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("PullRequestReviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  isActive             Boolean @default(true)
  feedbackAssistedByAi Boolean @default(false)

  analyses PrReviewAnalysis[]

  @@index([taskId, isActive])
  @@index([reviewedById])
  @@index([isActive, status, createdAt])
  @@index([githubRepositoryId, githubPullRequestNumber])
  @@schema("public")
}
