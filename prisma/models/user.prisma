enum MentorshipStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

enum MentorshipType {
  MONTHLY
  QUARTERLY
  SEMIANNUAL

  @@schema("public")
}

enum UserLocale {
  PT_BR
  EN

  @@schema("public")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credits              Int     @default(0)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  /// Projection of Clerk profile image URL (synced via user.created / user.updated webhooks).
  imageUrl String?

  /// Projection of Clerk org:admin membership for notification fan-out (synced via webhook).
  isOrgAdmin Boolean @default(false)

  taskDeadlineRemindersEnabled Boolean    @default(true)
  preferredLocale              UserLocale @default(PT_BR)

  // Mentorship
  mentorshipStatus         MentorshipStatus @default(INACTIVE)
  mentorshipType           MentorshipType?  @default(MONTHLY)
  mentorshipStartDate      DateTime?
  mentorshipEndDate        DateTime?
  weeklyMentorshipSessions Int              @default(1)
  remainingWeeklySessions  Int              @default(1)
  weeklySessionsResetAt    DateTime?

  normalOnboardingCompletedAt     DateTime?
  mentorshipOnboardingCompletedAt DateTime?

  learningGoal            String?
  selfReportedLevel      String?
  interestedTechnologies String[] @default([])
  weeklyAvailabilityBand String?
  priorExperience        String?
  diagnosisCompletedAt   DateTime?

  tasks                        Task[]
  sprintChanges                SprintChange[]
  projectMemberships           ProjectMembership[]
  comments                     Comment[]
  taskAttachments              TaskAttachment[]
  prReviewsRequested           PullRequestReview[]        @relation("PullRequestReviewRequester")
  prReviewsReviewed            PullRequestReview[]        @relation("PullRequestReviewReviewer")
  prReviewAnalysesRequested    PrReviewAnalysis[]         @relation("PRReviewAnalysisRequester")
  prReviewFindingDecisions     PrReviewFinding[]          @relation("PRReviewFindingDecisionMaker")
  milestonesReviewed           Milestone[]                @relation("MilestoneReviewer")
  portfolioEvaluations         Project[]                  @relation("ProjectPortfolioEvaluator")
  githubInstallations          GitHubInstallation[]
  createdPlanningPokerSessions PlanningPokerSession[]     @relation("PlanningPokerSessionCreator")
  retrospectivesHosted         Retrospective[]            @relation("RetrospectiveCreator")
  retrospectiveItems           RetrospectiveItem[]        @relation("RetrospectiveItemAuthor")
  planningPokerVotes           PlanningPokerVote[]
  notifications                Notification[]
  projectInvitationsReceived   ProjectInvitation[]        @relation("ProjectInvitationsReceived")
  projectInvitationsSent       ProjectInvitation[]        @relation("ProjectInvitationsSent")
  mentorshipBookings           MentorshipBooking[]
  competencyAssessmentsReceived CompetencyMentorAssessment[] @relation("CompetencyAssessmentLearner")
  competencyAssessmentsGiven    CompetencyMentorAssessment[] @relation("CompetencyAssessmentAssessor")
  remediationActions            RemediationAction[]          @relation("RemediationActionLearner")
  remediationActionsCreated     RemediationAction[]          @relation("RemediationActionCreator")
  remediationActionsCompleted   RemediationAction[]          @relation("RemediationActionCompleter")
  challengeProgress            UserChallengeProgress[]
  exerciseReviewSubmissions    ExerciseReviewSubmission[] @relation("ExerciseReviewSubmissions")
  exerciseReviewDecisions      ExerciseReviewDecision[]   @relation("ExerciseReviewDecisions")
  feedbackReports              FeedbackReport[]
  creditCheckouts              CreditCheckout[]
  mentorAttentionAssignments  MentorAttentionAssignment[] @relation("MentorAttentionAssignments")
  mentorAttentionCompletions  MentorAttentionAssignment[] @relation("MentorAttentionCompletions")
  learningJourneyEvents       LearningJourneyEvent[]
  learningPlans               LearningPlan[]         @relation("LearningPlanLearner")
  learningPlansCreated        LearningPlan[]         @relation("LearningPlanCreator")
  cohortsCreated              Cohort[]                    @relation("CohortCreator")
  cohortEventsCreated         CohortEvent[]                @relation("CohortEventCreator")
  cohortMemberships           CohortMembership[]
  peerReviewsGiven            CohortPeerReview[]          @relation("CohortPeerReviewReviewer")
  peerReviewsReceived         CohortPeerReview[]          @relation("CohortPeerReviewAuthor")
  peerReviewsDismissed        CohortPeerReview[]          @relation("CohortPeerReviewDismissal")
  peerReviewCalibrations      CohortPeerReviewCalibration[] @relation("CohortPeerReviewCalibrationReviewer")
  cohortProjectsAssigned      CohortProject[]             @relation("CohortProjectAssigner")
  peerReviewReportsFiled      CohortPeerReviewReport[]    @relation("CohortPeerReviewReporter")
  peerReviewReportsResolved   CohortPeerReviewReport[]    @relation("CohortPeerReviewReportResolver")

  @@index([isOrgAdmin])
  @@index([updatedAt])
  @@schema("public")
}
